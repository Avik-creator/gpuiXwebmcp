{
  "manifest_version": 3,
  "name": "WebMCP Debugger Bridge",
  "version": "0.1.0",
  "description": "Local-dev bridge from document.modelContext to the GPUI WebMCP debugger. Not for untrusted sites.",
  "key": "",
  "minimum_chrome_version": "150",
  "permissions": ["tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
